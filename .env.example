# Salim corre `npx convex dev` y comparte estos dos valores con el equipo.
# Anjali, Gael y Alejandro SOLO ponen NEXT_PUBLIC_CONVEX_URL / NEXT_PUBLIC_CONVEX_SITE_URL y corren `pnpm dev`.
# NO corran `npx convex dev` — sobrescribiría el backend de Salim.
NEXT_PUBLIC_CONVEX_URL=

# Solo en la máquina de Salim (lo escribe `npx convex dev` automáticamente)
CONVEX_DEPLOYMENT=

# Se configuran con `npx convex env set <NOMBRE> <valor>` (no en este archivo):
#   GEMINI_API_KEY      -> generacion de retos y reportes
#   JWT_PRIVATE_KEY / JWKS / SITE_URL -> los pone `npx @convex-dev/auth`
#   VAPI_*              -> audio, P2
